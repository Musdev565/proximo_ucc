# Copier en .env (NE PAS COMMITER .env)
# --- Base de données ---
DB_URL=jdbc:postgresql://localhost:5432/proximo
DB_USER=proximo
DB_PASSWORD=change-me
# --- JWT ---
JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=720
# --- Horaires (Africa/Kinshasa) ---
ORDERS_OPEN_TIME=06:00
ORDERS_CLOSE_TIME=15:30
DAILY_RESET_TIME=16:30
# --- Images S3 (optionnel au début) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Front ---
VITE_API_URL=http://localhost:8080/api
